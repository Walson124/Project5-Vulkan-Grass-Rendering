#version 450
#extension GL_ARB_separate_shader_objects : enable

#define ORIENTATION_CULL 0
#define VIEW_FRUSTUM_CULL 0
#define DISTANCE_CULL 0

#define WORKGROUP_SIZE 32
layout(local_size_x = WORKGROUP_SIZE, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform CameraBufferObject {
    mat4 view;
    mat4 proj;
} camera;

layout(set = 1, binding = 0) uniform Time {
    float deltaTime;
    float totalTime;
};

struct Blade {
    vec4 v0;
    vec4 v1;
    vec4 v2;
    vec4 up;
};

// TODO: Add bindings to:
// 1. Store the input blades
// 2. Write out the culled blades
// 3. Write the total number of blades remaining

// The project is using vkCmdDrawIndirect to use a buffer as the arguments for a draw call
// This is sort of an advanced feature so we've showed you what this buffer should look like
//
// layout(set = ???, binding = ???) buffer NumBlades {
// 	  uint vertexCount;   // Write the number of blades remaining here
// 	  uint instanceCount; // = 1
// 	  uint firstVertex;   // = 0
// 	  uint firstInstance; // = 0
// } numBlades;

layout(set = 2, binding = 0) buffer Blades {
    Blade blades[];
};

layout(set = 2, binding = 1) buffer Culled {
    Blade culled[];
};

layout(set = 2, binding = 2) buffer NumBlades {
    uint vertexCount;   // Write the number of blades remaining here
    uint instanceCount; // = 1
    uint firstVertex;   // = 0
    uint firstInstance; // = 0
} numBlades;

bool inBounds(float value, float bounds) {
    return (value >= -bounds) && (value <= bounds);
}

void main() {
	// Reset the number of blades to 0
	if (gl_GlobalInvocationID.x == 0) {
		numBlades.vertexCount = 0;
	}
	barrier(); // Wait till all threads reach this point

    // TODO: Apply forces on every blade and update the vertices in the buffer
    uint index = gl_GlobalInvocationID.x;
    if (index >= blades.length()) return;
    Blade blade = blades[index];

    vec3 v0 = blade.v0.xyz;
    vec3 v1 = blade.v1.xyz;
    vec3 v2 = blade.v2.xyz;
    vec3 up = blade.up.xyz;
    float orientation = blade.v0.w;
    vec3 camPos = inverse(camera.view)[3].xyz;

    // gravity
    vec4 D = vec4(0.0, -1.0, 0.0, 4);
    vec3 gravity = normalize(D.xyz) * D.w;
    vec3 gF = .25 * length(gravity) * vec3(-sin(orientation), 0.0, cos(orientation));

    // recovery
    vec3 iv2 = v0 + up * blade.v1.w;
    vec3 r = (iv2 - v2) * blade.up.w;

    // wind
    vec3 windDirection = vec3(sin(totalTime + v0.x / 3), 0, 0);
    float windAlignment = 3;
    vec3 w = windDirection * windAlignment;

    // total force
    v2 += (gF + gravity + r + w) * deltaTime;
    v2 = v2 - up * min(dot(up, v2 - v0), 0);
    float temp = length(v2 - v0 - up * dot(v2 - v0, up));
    blade.v1.xyz = v0 + blade.v1.w * up * max(1 - temp / blade.v1.w, 0.05 * max(temp / blade.v1.w, 1));

    // correct it
    v1 = blade.v1.xyz;
    float L = (2 * distance(v0, v2) + (distance(v0, v1) + distance(v1, v2))) / 3;
    float r2 = blade.v1.w / L;
    blade.v1.xyz = v0 + r2 * (v1 - v0);
    blade.v2.xyz = blade.v1.xyz + r2 * (v2 - v1);

    v1 = blade.v1.xyz; // for culling to process
    v2 = blade.v2.xyz;
    blades[index] = blade;


	// TODO: Cull blades that are too far away or not in the camera frustum and write them
	// to the culled blades buffer
	// Note: to do this, you will need to use an atomic operation to read and update numBlades.vertexCount
	// You want to write the visible blades to the buffer without write conflicts between threads

#if ORIENTATION_CULL
    // orientation test
    vec3 t1 = vec3(cos(orientation), 0.0, sin(orientation));
    if (0.9 < abs(dot(normalize(v0 - camPos), t1))) { // flip of the paper
        return;
    }
#endif

#if VIEW_FRUSTUM_CULL
    // View-frustum test, calculate for v0, m, v2
    vec3 m  = 0.25 * v0 + 0.5 * v1 + 0.25 * v2; // midpoint from paper
    mat4 VP = camera.proj * camera.view;

    // p' = VPp
    vec4 p0 = VP * vec4(v0, 1.0);
    vec4 pm = VP * vec4(m, 1.0);
    vec4 p2 = VP * vec4(v2, 1.0);

    // h = p'w + t
    float t = 0.5; // tolerance
    float h0 = p0.w + t;
    float hm = pm.w + t;
    float h2 = p2.w + t;

    // big v equation
    bool bigv0 = inBounds(p0.x, h0) && inBounds(p0.y, h0) && inBounds(p0.z, h0);
    bool bigvm  = inBounds(pm.x, hm) && inBounds(pm.y, hm) && inBounds(pm.z, hm);
    bool bigv2 = inBounds(p2.x, h2) && inBounds(p2.y, h2) && inBounds(p2.z, h2);

    if (!bigv0 && !bigvm && !bigv2) {
        return;
    }
#endif

#if DISTANCE_CULL
    float distance = length(v0 - camPos - up * dot((v0 - camPos), up));

    float distance_max = 25;
    uint n = 10;
    if (index % n > floor(n * (1 - distance / distance_max))) {
        return;
    }

#endif

    uint slot = atomicAdd(numBlades.vertexCount, 1);
    culled[slot] = blade;
}
